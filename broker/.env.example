# کلید دائمی فقط روی سرور بماند؛ هرگز آن را در Extension قرار ندهید.
SONIOX_API_KEY=replace-with-server-side-soniox-key
# توکن قوی و یکتا برای استفاده شخصی؛ دسترسی به endpoint صدور کلید موقت را محدود می‌کند.
BROKER_ACCESS_TOKEN=replace-with-a-long-random-secret
# شناسهٔ اکستنشن Chrome را از chrome://extensions بردارید.
ALLOWED_ORIGINS=chrome-extension://replace-with-your-extension-id
PORT=8787
HOST=0.0.0.0
